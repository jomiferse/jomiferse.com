{
  "name": "jomiferse.com",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.ts",
    "test:build": "node --test tests/build/*.test.ts",
    "check": "astro check",
    "lint": "eslint . --cache --cache-location .eslintcache --max-warnings 0",
    "lint:fix": "eslint . --cache --cache-location .eslintcache --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run test && pnpm run check && pnpm run build && pnpm run test:build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.11",
    "astro": "^7.3.4",
    "astro-icon": "^1.2.0",
    "resend": "^6.28.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vercel": "^59.25.4"
  }
}
