---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getLocaleStaticPaths, getTranslations, t } from "@/i18n";
import BlogFeaturedPost from "@/components/cards/BlogFeaturedPost.astro";
import BlogCarousel from "@/components/common/BlogCarousel.astro";
import BlogPagination from "@/components/common/BlogPagination.astro";
import ConversionCta from "@/components/common/ConversionCta.astro";
import {
	getBlogPostGroups,
	getLocalBlogSlug,
	getPublishedBlogPostsByAudience,
} from "@/lib/blog";
import { getPageItems, getTotalPages } from "@/lib/blog-pagination";
import { buildBreadcrumbList, buildCollectionPage } from "@/lib/seo";

export function getStaticPaths() {
	return getLocaleStaticPaths();
}

const { locale } = Astro.params;
const posts = await getPublishedBlogPostsByAudience(locale, "technical");
const { primaryFeatured, archivePosts } = getBlogPostGroups(posts);
const currentPage = 1;
const totalPages = getTotalPages(archivePosts.length);
const latestPosts = getPageItems(archivePosts, currentPage);

const blogBasePath = `/${locale}/blog`;
const archivePath = `${blogBasePath}/technical`;
const dateLocale = locale === "es" ? "es-ES" : "en-GB";
const blogPage = getTranslations(locale).blog.page;
const archive = getTranslations(locale).blog.technicalArchive;
const empty = getTranslations(locale).blog.empty;
const pagination = getTranslations(locale).blog.pagination;
const pageTitle = archive.meta.title;
const pageDescription = archive.meta.description;
const site = Astro.site?.toString() ?? "https://www.jomiferse.com";
const structuredData = [
	buildCollectionPage(site, archivePath, pageTitle, pageDescription),
	buildBreadcrumbList(site, [
		{ name: t(locale, "nav.home"), path: `/${locale}` },
		{ name: t(locale, "nav.blog"), path: blogBasePath },
		{ name: archive.breadcrumb, path: archivePath },
	]),
];
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	canonicalPath={archivePath}
	alternatePaths={{
		en: "/en/blog/technical",
		es: "/es/blog/technical",
	}}
	structuredData={structuredData}
>
	<div class="blog-page">
		<section
			class="section-reveal grid gap-8 pt-5 pb-12 md:grid-cols-[minmax(0,1fr)_minmax(18rem,0.42fr)] md:items-end md:pt-8 md:pb-16"
		>
			<div>
				<p class="eyebrow text-[var(--action)]">{archive.eyebrow}</p>
				<h1
					class="mt-4 max-w-5xl text-5xl leading-[0.98] font-black text-[var(--home-navy)] sm:text-6xl md:text-7xl"
				>
					{archive.title}
				</h1>
			</div>
			<div>
				<p class="muted-copy text-lg leading-8">{archive.intro}</p>
				<a href="#technical-archive" class="button-action mt-6">
					{archive.browseArticles}
					<Icon
						name="arrow-right"
						class="h-4 w-4 rotate-90"
						aria-hidden="true"
					/>
				</a>
			</div>
		</section>

		<section class="section-reveal pb-12 md:pb-16">
			{
				primaryFeatured ? (
					<BlogFeaturedPost
						href={`${blogBasePath}/${getLocalBlogSlug(primaryFeatured.id, locale)}`}
						title={primaryFeatured.data.title}
						description={primaryFeatured.data.description}
						dateLabel={primaryFeatured.data.date.toLocaleDateString(
							dateLocale,
							{
								year: "numeric",
								month: "short",
								day: "numeric",
							},
						)}
						readingTime={primaryFeatured.data.readingTime}
						cover={primaryFeatured.data.cover}
						featuredLabel={archive.featuredEyebrow}
						readLabel={blogPage.readArticle}
					/>
				) : (
					<div class="dark-card p-6 text-[var(--text-muted)]">
						{empty.featured}
					</div>
				)
			}
		</section>

		<section id="technical-archive" class="section-reveal pb-16 md:pb-24">
			<div class="mb-7 flex flex-col gap-2">
				<h2 class="text-3xl font-black text-[var(--text)] md:text-4xl">
					{archive.latestTitle}
				</h2>
				<p class="muted-copy">{archive.latestSubtitle}</p>
			</div>
			{
				latestPosts.length > 0 ? (
					<BlogCarousel
						posts={latestPosts}
						locale={locale}
						blogBasePath={blogBasePath}
						dateLocale={dateLocale}
						label={archive.latestTitle}
						copy={blogPage}
					/>
				) : (
					<div class="dark-card p-6 text-[var(--text-muted)]">
						{empty.latest}
					</div>
				)
			}
			<BlogPagination
				locale={locale}
				currentPage={currentPage}
				totalPages={totalPages}
				labels={pagination}
				audience="technical"
			/>
			<div class="mt-10 border-t border-[var(--surface-border)] pt-7">
				<a
					href={`${blogBasePath}/`}
					class="inline-flex items-center gap-2 text-sm font-black text-[var(--text)] hover:text-[var(--action)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--action)]"
				>
					<Icon name="arrow-left" class="h-4 w-4" aria-hidden="true" />
					{archive.businessLabel}
				</a>
				<p class="muted-copy mt-2 max-w-2xl text-sm leading-6">
					{archive.businessDescription}
				</p>
			</div>
		</section>

		<ConversionCta
			eyebrow={blogPage.cta.eyebrow}
			title={blogPage.cta.title}
			text={blogPage.cta.text}
			primary={{ label: blogPage.cta.services, href: `/${locale}/services` }}
			secondary={{ label: blogPage.cta.contact, href: `/${locale}/contact` }}
			headingId="technical-blog-conversion-title"
		/>
	</div>
</BaseLayout>
