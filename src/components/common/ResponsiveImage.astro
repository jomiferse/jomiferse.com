---
import { getResponsiveImageSources } from "@/lib/responsive-images";

interface Props {
	src: string;
	alt: string;
	width: number | string;
	height: number | string;
	sizes: string;
	class?: string;
	loading?: "eager" | "lazy";
	decoding?: "async" | "auto" | "sync";
	fetchpriority?: "high" | "low" | "auto";
}

const {
	src,
	alt,
	width,
	height,
	sizes,
	class: className,
	loading,
	decoding = "async",
	fetchpriority,
} = Astro.props as Props;
const sources = getResponsiveImageSources(src);
---

<picture class="responsive-image">
	{
		sources.avif ? (
			<source type="image/avif" srcset={sources.avif} sizes={sizes} />
		) : null
	}
	{
		sources.webp ? (
			<source type="image/webp" srcset={sources.webp} sizes={sizes} />
		) : null
	}
	<img
		src={src}
		srcset={sources.avif}
		alt={alt}
		width={width}
		height={height}
		sizes={sizes}
		class={className}
		loading={loading}
		decoding={decoding}
		fetchpriority={fetchpriority}
	/>
</picture>
